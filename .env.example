# SQLite for local. Swap to PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/hale"
DATABASE_URL="file:./dev.db"

# Canonical public origin (emails, magic links). SITE_URL is an alias.
PUBLIC_APP_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# Providers: mock | openai | fal | replicate
# If a live provider is selected without a key, the app falls back to mock
# and Imagine shows a quiet desk notice that the camera is not live.
AI_IMAGE_PROVIDER=mock
AI_STT_PROVIDER=mock
SUMMARY_PROVIDER=mock

# Backward-compatible aliases:
# IMAGE_PROVIDER=mock
# STT_PROVIDER=mock

# Live keys — required only when the matching provider is not mock.
# Live image calls cost money. Keep mock for local work unless you mean to spend.
# OPENAI_API_KEY=
# FAL_KEY=
# REPLICATE_API_TOKEN=

# Letters to the studio. console | resend | smtp
# console writes to the terminal and /studio/inbox — it does not send Gmail.
# Switch to resend or smtp only when the client is ready for live mail.
EMAIL_PROVIDER=console
STUDIO_INBOX_EMAIL=kennnyfagbenro44@gmail.com
# EMAIL_FROM="Hale Studio <kennnyfagbenro44@gmail.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Decorator inbox at /studio/inbox
STUDIO_INBOX_PASSWORD=
